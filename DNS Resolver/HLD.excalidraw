    {
      "id": "qTwiB-kgiL2-zg6iStCEV",
      "type": "text",
      "x": 231,
      "y": 132,
      "width": 1396,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
