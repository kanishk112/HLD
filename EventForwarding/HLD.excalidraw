  "elements": [
    {
      "id": "maM-szqrff3URb0TlvkGA",
      "type": "text",
      "x": 174.9472837772728,
      "y": 16.22245957195753,
      "width": 1524.8625222665296,
      "height": 922.4040612721402,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
