    {
      "id": "gUdvhVcpdpzjq1yYghdlM",
      "type": "text",
      "x": 296,
      "y": 1765,
      "width": 1493,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
