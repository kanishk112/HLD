    {
      "id": "B61E16DVyo91Oe6YrrQKd",
      "type": "text",
      "x": 338.004617525489,
      "y": 1946.8229225168486,
      "width": 125.87051391601562,
      "height": 19.09313085892729,
      "angle": 0,
