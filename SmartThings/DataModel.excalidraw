    {
      "id": "fLQ3iWeH_0-y7fBpguRxl",
      "type": "text",
      "x": 1347,
      "y": 1508,
      "width": 174.7598419189453,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
