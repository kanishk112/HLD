    {
      "id": "Rk4x0ZZxVlhHHHX0I4g3D",
      "type": "text",
      "x": 228,
      "y": 130,
      "width": 1893,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
