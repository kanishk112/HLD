    {
      "id": "iqj0uJnh5lDtMlcnQ1DbQ",
      "type": "text",
      "x": 244.99999999999977,
      "y": 7467,
      "width": 1494.3977050781252,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 922860274,
      "version": 309,
      "versionNonce": 494782062,
