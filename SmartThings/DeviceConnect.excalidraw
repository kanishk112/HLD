    {
      "id": "52U9naFyz1RD6Ek8S4j4o",
      "type": "text",
      "x": 258,
      "y": 980,
      "width": 1432.3168945312502,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
